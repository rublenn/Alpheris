# Copy this file to .env.local for local development, and add the same
# names in Netlify → Site configuration → Environment variables.
# NEVER commit real values. .env.local is ignored by git.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://abmjkwdnggqejhuvacth.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Razorpay → Account & Settings → API Keys (Test mode first: rzp_test_...)
# Leave empty to keep online payment switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → the secret you typed when adding the webhook (optional but recommended)
RAZORPAY_WEBHOOK_SECRET=

# Delivery charge added to every order, in paise (₹150 = 15000). 0 = no charge.
DELIVERY_FEE_PAISE=0

# New-order email alert (resend.com → API Keys). Leave empty to switch off.
RESEND_API_KEY=
# Who receives the alert, e.g. the shop's email. Several: a@x.com,b@y.com
ORDER_ALERT_EMAIL=
# Optional sender. Keep empty until a domain is verified in Resend.
ORDER_ALERT_FROM=
